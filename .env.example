# LLM provider (the final answer model)
# The project can reuse the vision key below when both providers are the same.
LLM_API_KEY=${VISION_LLM_API_KEY}
LLM_BASE_URL=https://sudobug.top/v1
LLM_MODEL=gpt-5.6-luna
LLM_LUNA_API_KEY=
LLM_LUNA_BASE_URL=https://sudobug.top/v1
LLM_DEEPSEEK_FLASH_API_KEY=
LLM_DEEPSEEK_FLASH_BASE_URL=https://sudobug.top/v1

# Optional vision model used during image/PDF/DOCX/PPTX ingestion.
# Keep this separate from the local Qwen answer model.
VISION_LLM_API_KEY=replace-with-your-vision-provider-key
VISION_LLM_BASE_URL=https://sudobug.top/v1
VISION_LLM_MODEL=gpt-5.6-terra
VISION_LLM_TIMEOUT=90
CONTEXTUAL_RETRIEVAL_ENABLED=false
CONTEXTUAL_RETRIEVAL_MODEL=gpt-5.6-luna
FORMULA_RECOGNITION_ENABLED=true
FORMULA_RECOGNITION_MODEL=PP-FormulaNet_plus-M
OCR_DEVICE=cpu
FORMULA_RECOGNITION_DEVICE=cpu
PADDLE_PDX_CACHE_HOME=models/paddlex

# Local Ollama alternative (optional)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
# Windows model storage is configured with the user variable OLLAMA_MODELS.
# Recommended value: E:\\ollama\\models

# Milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# Embedding model. Use a local path or a model id supported by Sentence Transformers.
EMBEDDING_MODEL=models/models/AI-ModelScope--bge-small-zh-v1.5/snapshots/master
MODEL_CACHE=models
RAG_WORK_DIR=data/.work
RAG_ORIGINAL_DIR=data/original

# Future async pipeline
REDIS_URL=redis://127.0.0.1:6379/0

# MySQL (metadata, sessions, memory). Values are interpolated by docker-compose.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=rag
MYSQL_USER=rag
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_PASSWORD=replace-with-a-strong-app-password

# 鉴权（JWT）：必须设置一个强随机值，否则 config 会打印警告并退回不安全默认值
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_SETUP_TOKEN_EXPIRE_MINUTES=15
